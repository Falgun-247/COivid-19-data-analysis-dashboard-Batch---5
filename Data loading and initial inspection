import pandas as pd
import numpy as np

# Load the dataset
# Preserve country code "NA" and treat empty strings as missing
df = pd.read_csv(
    "/content/WHO-COVID-19-global-daily-data.csv",
    keep_default_na=False,
    na_values=[""]
)

# Display first 5 records
print("First 5 rows:")
print(df.head())

# Display dataset shape
print("\nDataset Shape:")
print(df.shape)

# Display column names
print("\nColumn Names:")
print(df.columns.tolist())

# Display data types
print("\nData Types:")
print(df.dtypes)

# Display missing values
print("\nMissing Values:")
print(df.isna().sum())
